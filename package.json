{
	"name": "react-remote-control",
	"version": "0.1.0",
	"description": "Peer-to-peer WebRTC connection primitive for React 19 with auto-QR, synced state hooks, and media calls.",
	"keywords": [
		"react",
		"react19",
		"hooks",
		"webrtc",
		"peerjs",
		"peer-to-peer",
		"realtime",
		"remote-control",
		"synced-state",
		"qr-code"
	],
	"license": "MIT",
	"author": "Koen Mostert <reaxis@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reaxis/react-remote-control.git"
	},
	"homepage": "https://github.com/reaxis/react-remote-control#readme",
	"bugs": {
		"url": "https://github.com/reaxis/react-remote-control/issues"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.build.json",
		"build:playground": "vite build",
		"preview": "vite preview",
		"prepack": "rm -rf dist && npm run build && publint",
		"check": "tsc --noEmit && tsc --noEmit -p playground",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"peerjs": "^1.5.0",
		"qrcode": "^1.5.0",
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^30.1.3",
		"peerjs": "^1.5.5",
		"publint": "^0.3.25",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	}
}
